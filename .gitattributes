# Git LFS — track large SQLite DB files
# Hugging Face Spaces has Git LFS built-in (10 GB free)
# No setup needed — just git add data/experiments.db and push
*.db     filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text

# Immutable workload assets: hashes are pinned on LF bytes
studies/energy_diagnosis/workloads/assets/sales.csv text eol=lf
studies/energy_diagnosis/workloads/assets/expected_result.json text eol=lf

# All pilot identities use canonical LF checkout bytes on Windows and Linux.
studies/energy_diagnosis/workloads/pilot_assets/** text eol=lf
